# Never commit the real .env
ANTHROPIC_API_KEY=sk-ant-...
ORBIT_MODEL=claude-sonnet-4-6

# Comma-separated. Your deployed site only. No wildcards.
ALLOWED_ORIGINS=https://satishwagle.com,http://localhost:8080

# Proxy hops in front of the service. 2 is correct for Cloud Run.
TRUSTED_PROXY_HOPS=2

RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_S=300
DAILY_CALL_BUDGET=600
