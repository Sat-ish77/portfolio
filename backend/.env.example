# Never commit the real .env
ANTHROPIC_API_KEY=sk-ant-...
ORBIT_MODEL=claude-sonnet-4-6

# Comma-separated. Your deployed site only. No wildcards.
ALLOWED_ORIGINS=https://satishwagle.com,http://localhost:8080

# Proxy hops in front of the service. 2 is correct for Cloud Run.
TRUSTED_PROXY_HOPS=2

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_S=86400
DAILY_CALL_BUDGET=100

# Used only by generate_intro_audio.py to create a static opening MP3.
# These are never exposed to the frontend or required by Cloud Run.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
